{
  "name": "bbq-scorecard",
  "version": "3.6.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:notebook": "vite --config vite.config.notebook.js",
    "dev:board": "vite --config vite.config.board.js",
    "audit": "npm audit --omit=dev --audit-level=high",
    "build": "vite build",
    "build:native": "vite build --config vite.config.native.js",
    "build:notebook": "vite build --config vite.config.notebook.js",
    "build:notebook-native": "vite build --config vite.config.native.notebook.js",
    "build:calculator-prices": "node scripts/generate-calculator-prices.mjs",
    "build:calculator": "npm run build:calculator-prices && vite build --config vite.config.calculator.js",
    "build:catering": "vite build --config vite.config.catering.js",
    "build:board": "vite build --config vite.config.board.js",
    "build:board-native": "vite build --config vite.config.native.board.js",
    "sync:notebook": "node scripts/sync-notebook.mjs",
    "sync:board": "node scripts/sync-board.mjs",
    "sync:rules": "node scripts/sync-firestore-rules.mjs",
    "check:rules": "node scripts/sync-firestore-rules.mjs --check",
    "deploy:rules": "node scripts/sync-firestore-rules.mjs && firebase deploy --only firestore:rules",
    "build:landing": "node scripts/assemble-dist.mjs",
    "build:all": "npm run build && npm run build:notebook && npm run build:calculator && npm run build:catering && npm run build:board && npm run build:landing",
    "build:safe": "npm run audit && npm run build:all",
    "preview": "vite preview",
    "deploy": "npm run audit && npm run build:all && netlify deploy --prod --dir=dist"
  },
  "dependencies": {
    "@capacitor-firebase/analytics": "^8.3.0",
    "@capacitor-firebase/authentication": "^8.2.0",
    "@capacitor-firebase/crashlytics": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/share": "^8.0.1",
    "firebase": "^12.14.0",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "psychrolib": "^1.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@preact/preset-vite": "^2.10.5",
    "@vitejs/plugin-react": "^4.2.0",
    "gh-pages": "^6.3.0",
    "netlify-cli": "^26.0.2",
    "preact": "^10.29.2",
    "sharp": "^0.34.5",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.17.0"
  }
}
