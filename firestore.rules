rules_version = '2';

// ─────────────────────────────────────────────────────────────
// Holy Smokes BBQ — Firestore Security Rules
// ─────────────────────────────────────────────────────────────
// Data model:
//   users/{userId}                            — profile
//   users/{userId}/friends/{friendId}         — accepted friendship (mutual)
//   users/{userId}/friendRequests/{fromUid}   — incoming friend request inbox
//   friendCodes/{code}                        — code → userId lookup
//   reviews/{userId}_{reviewId}               — restaurant reviews
//   cooks/{userId}_{cookId}                   — cook log entries
//   recipes/{userId}_{recipeId}               — recipes
//
// Doc ID convention: per-user record collections use `{userId}_{recordId}`
// so the owner is derivable from the path.
//
// Friendship model (mutual consent):
//   1. Requester writes one doc to users/{target}/friendRequests/{requester}.
//   2. Target sees the request in their inbox and accepts.
//   3. On accept, the target writes both friend docs in a single batch:
//        users/{target}/friends/{requester}   (owner write, request exists)
//        users/{requester}/friends/{target}   (cross-user write, allowed
//          because the requester's friendship doc can only be created by
//          someone with a matching incoming request — verified by exists()).
//      Then deletes the request.
//   This blocks the forced-friendship IDOR previously possible when any
//   signed-in user who knew a target's UID could write directly into the
//   target's friends list. (Security Audit Finding #1.)
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isFriendOf(ownerUid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(ownerUid)/friends/$(request.auth.uid));
    }

    function docIdBelongsTo(docId, ownerUid) {
      return docId.matches('^' + ownerUid + '_.+');
    }

    // Field whitelists — block injection of unexpected keys (audit #6).
    function reviewFields() {
      return [
        'id', 'userId', 'restaurant', 'location', 'date', 'trip',
        'meats', 'meatOther', 'sides', 'sideOther', 'dessert',
        'scores', 'sauceDep', 'wouldReturn', 'notes', 'notesLog',
        'price', 'priceSplit', 'googleReviewUrl', 'photo', 'photos',
        'friends', 'lastEdited', 'restaurantKey', 'syncedAt', 'drinks', 'orderStyle',
        'party', 'partySize', 'serviceNote', 'atmosphereNote', 'googleExtras', 'googleRatings'
      ];
    }

    function cookFields() {
      return [
        'id', 'userId', 'name', 'date', 'meatType', 'cut', 'weight',
        'rub', 'rubRecipeId', 'sauce', 'sauceRecipeId', 'woodType',
        'smokerType', 'fuelSource', 'cookTemp', 'wrapMethod', 'wrapTemp',
        'targetInternalTemp', 'cookTimeHours', 'cookTimeMinutes', 'restTime',
        'weatherTemp', 'weatherWind', 'weatherHumidity', 'photos',
        'notes', 'notesLog', 'rating', 'tags', 'shared', 'whatIdChange',
        'createdAt', 'lastEdited', 'restaurantKey', 'syncedAt',
        // Pit humidity (Notebook). Shipped in the client v3.0.1 but never
        // added here, so prepCookForFirestore dropped them on every write and
        // the readings never reached the cloud. Listing them is permissive —
        // hasOnly() only rejects keys NOT in this list — so publishing this
        // ahead of the matching client change is safe and is the required
        // order: rules must allow a field before the client starts sending it.
        'pitWetBulbF', 'pitPressureKPa'
      ];
    }

    function recipeFields() {
      return [
        'id', 'userId', 'type', 'name', 'ingredients', 'cookMethod',
        'meatType', 'instructions', 'rubRecipeId', 'sauceRecipeId',
        'woodRecommendation', 'tempGuidelines', 'timeGuidelines',
        'notes', 'rating', 'shared',
        'createdAt', 'lastEdited', 'syncedAt'
      ];
    }

    // ── USERS ────────────────────────────────────────────────
    // Profile fields readable by any signed-in user — required for friend
    // lookups (friendCodes → users → display name/photo). Email exposure
    // is a documented tradeoff (audit Finding #9). Future hardening:
    // split into public/private subcollections.
    match /users/{userId} {
      allow read: if isSignedIn();

      // `email` is permitted but NOT required, and is no longer compared
      // against the auth token. Audit finding F9 stopped the client writing
      // `email` into this doc, but the rule was never updated to match, so it
      // demanded a field the payload no longer carried and denied EVERY new
      // profile creation. That is what App Review hit on 4.0.0 builds 8 and 9
      // (Guideline 2.1(a)): Sign in with Apple always creates a NEW user, the
      // profile write was denied, userProfile stayed null, and Profile/Settings
      // — which render on `fbUser && userProfile` — fell back to the sign-in
      // buttons as if the login had been refused. `email` stays in the
      // whitelist so shipped builds that still send it are not broken.
      allow create: if isOwner(userId)
                    && request.resource.data.keys().hasOnly([
                      'displayName', 'email', 'photoURL', 'friendCode', 'createdAt'
                    ]);

      allow update: if isOwner(userId)
                    && request.resource.data.friendCode == resource.data.friendCode
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.keys().hasOnly([
                      'displayName', 'email', 'photoURL', 'friendCode', 'createdAt'
                    ]);

      // In-app account deletion (register #1, Apple 5.1.1(v)): the owner
      // can delete their own profile. The client deletes it last, after the
      // reviews, friends, friend requests and friend code it points at.
      // Published to holy-smokes-bbq-scorecard 2026-10-21 08:54.
      allow delete: if isOwner(userId);

      // ── FRIENDS SUBCOLLECTION ─────────────────────────────
      // Created ONLY as part of an accept-request flow. See header comment.
      match /friends/{friendId} {
        allow read: if isOwner(userId);

        allow create: if isSignedIn()
                      && (
                        // Owner accepting a request in their own inbox
                        (request.auth.uid == userId
                         && exists(/databases/$(database)/documents/users/$(userId)/friendRequests/$(friendId)))
                        ||
                        // Counterpart write into requester's friends list.
                        // The accepter (auth.uid) IS `friendId`, and their
                        // own inbox contains the request from `userId`.
                        (request.auth.uid == friendId
                         && exists(/databases/$(database)/documents/users/$(friendId)/friendRequests/$(userId)))
                      )
                      && request.resource.data.keys().hasOnly([
                        'displayName', 'photoURL', 'friendCode', 'addedAt'
                      ]);

        // Either side can unfriend at any time.
        allow delete: if isSignedIn()
                      && (request.auth.uid == userId || request.auth.uid == friendId);

        allow update: if false;
      }

      // ── FRIEND REQUESTS (incoming inbox) ─────────────────
      // Path: users/{userId}/friendRequests/{requesterUid}
      // userId = target of the request, requesterUid = who's asking.
      match /friendRequests/{requesterUid} {
        // Only the inbox owner can list/read.
        allow read: if isOwner(userId);

        // Anyone can drop a request — but only with their own uid as
        // the doc id, can't self-request, and only with the allowed fields.
        allow create: if isSignedIn()
                      && request.auth.uid == requesterUid
                      && request.auth.uid != userId
                      && request.resource.data.keys().hasOnly([
                        'displayName', 'photoURL', 'friendCode', 'requestedAt'
                      ]);

        // Target deletes on accept/reject; requester deletes to cancel.
        allow delete: if isSignedIn()
                      && (request.auth.uid == userId || request.auth.uid == requesterUid);

        allow update: if false;
      }
    }

    // ── FRIEND CODES ─────────────────────────────────────────
    match /friendCodes/{code} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && code.matches('^BBQ-[A-Z0-9]{4,6}$')
                    && request.resource.data.keys().hasOnly(['userId']);

      allow update: if false;
      // In-app account deletion: the code's owner can release it. Only the
      // doc whose stored userId is the caller, so nobody can free someone
      // else's code.
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ── REVIEWS ──────────────────────────────────────────────
    match /reviews/{docId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || isFriendOf(resource.data.userId)
      );

      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && docIdBelongsTo(docId, request.auth.uid)
                    && request.resource.data.keys().hasOnly(reviewFields());

      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasOnly(reviewFields());

      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
    }

    // ── COOKS (Notebook) ─────────────────────────────────────
    match /cooks/{docId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || (resource.data.shared == true && isFriendOf(resource.data.userId))
      );

      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && docIdBelongsTo(docId, request.auth.uid)
                    && request.resource.data.keys().hasOnly(cookFields());

      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasOnly(cookFields());

      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
    }

    // ── RECIPES (Notebook) ───────────────────────────────────
    match /recipes/{docId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || (resource.data.shared == true && isFriendOf(resource.data.userId))
      );

      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && docIdBelongsTo(docId, request.auth.uid)
                    && request.resource.data.keys().hasOnly(recipeFields());

      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasOnly(recipeFields());

      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
    }

    // ── BOARD PRICES (BBQ Board) ─────────────────────────────
    // Public price directory for meat cuts. Read-open (anyone, even
    // signed-out, can browse). Write-auth: signed-in users can submit
    // one document per submission, must be their own userId, and the
    // whitelist + enum + shape checks block a series of attacks
    // catalogued in SECURITY-AUDIT-BOARD-DEEP.md.
    //
    // Locked down against (see SECURITY-AUDIT-BOARD-DEEP.md):
    //   - B-1: server-side timestamp required so a client cannot pin a
    //          $0.01 fake brisket at a real butcher with a year-9999
    //          reportedAt that beats every honest recent report; shopId
    //          constrained so a user cannot attribute a community price
    //          to a directory shop id they don't own.
    //   - B-2: docId cannot start with 'seed_' — the client uses that
    //          prefix as a Verified-badge fallback (kept as a bug in
    //          older builds), so blocking it at the rules layer
    //          neutralises any attempt to forge trust.
    //   - B-3 (partial): shopId/location/notes bounded to prevent
    //          arbitrary junk from bloating queries and costs. Full App
    //          Check + per-user rate limiting is a separate follow-up.
    //   - B-5: region allowlist now covers all 27 REGIONS in schema.js
    //          (previously missed 8 metros like atlanta_metro,
    //          silently rejecting real submissions).
    //   - Older B-1 XSS (from the first audit): also mitigated by the
    //          cut enum below.
    match /board_prices/{docId} {
      allow read: if true;

      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    // Block docId 'seed_' prefix forgery (Finding B-2)
                    && !docId.matches('^seed_.*')
                    && request.resource.data.keys().hasOnly([
                      'userId', 'shopId', 'store', 'storeType', 'region', 'location',
                      'cut', 'pricePerLb', 'notes', 'source', 'reportedAt'
                    ])
                    // Server-side timestamp only — client cannot fake past/future (B-1)
                    && request.resource.data.reportedAt == request.time
                    && request.resource.data.store is string
                    && request.resource.data.store.size() > 0
                    && request.resource.data.store.size() <= 80
                    && request.resource.data.pricePerLb is number
                    && request.resource.data.pricePerLb > 0
                    && request.resource.data.pricePerLb <= 100
                    // shopId shape: bounded string, cannot start with 'seed_'
                    // (Finding B-1: attribution forgery)
                    && request.resource.data.shopId is string
                    && request.resource.data.shopId.size() > 0
                    && request.resource.data.shopId.size() <= 120
                    && !request.resource.data.shopId.matches('^seed_.*')
                    // location: bounded (Finding B-3 partial)
                    && request.resource.data.location is string
                    && request.resource.data.location.size() <= 120
                    // The three enum blocks below are generated from
                    // src/board/schema.js by scripts/sync-firestore-rules.mjs.
                    // NEVER edit them by hand — edit schema.js and run
                    // `npm run deploy:rules` (which syncs + deploys).
                    // /* @sync:cuts */
                    && request.resource.data.cut in [
                      'brisket_prime', 'brisket_choice', 'brisket_select', 'ribeye',
                      'filet_mignon', 'tbone', 'porterhouse', 'sirloin', 'flank', 'chuck_roast',
                      'tri_tip', 'ground_beef_80', 'pork_shoulder', 'spare_ribs', 'baby_back_ribs',
                      'bratwurst_fresh', 'bratwurst_smoked', 'whole_chicken', 'chicken_breast',
                      'whole_turkey'
                    ]
                    // /* @endsync */
                    // /* @sync:regions */
                    && request.resource.data.region in [
                      'milwaukee_metro', 'madison_metro', 'fox_valley', 'green_bay',
                      'chicago_metro', 'kansas_city_metro', 'austin_metro', 'memphis_metro',
                      'nashville_metro', 'st_louis_metro', 'dallas_metro', 'houston_metro',
                      'san_antonio_metro', 'birmingham_metro', 'boise_metro', 'lexington_metro',
                      'greenville_metro', 'owensboro_metro', 'lockhart_metro', 'atlanta_metro',
                      'louisville_metro', 'charlotte_metro', 'raleigh_metro', 'columbia_metro',
                      'lexington_nc_metro', 'tuscaloosa_metro', 'oklahoma_city_metro',
                      'tulsa_metro', 'little_rock_metro', 'new_orleans_metro', 'savannah_metro',
                      'denver_metro', 'jacksonville_metro', 'phoenix_metro', 'wichita_metro',
                      'twin_cities_metro', 'omaha_metro', 'cincinnati_metro', 'indianapolis_metro',
                      'pittsburgh_metro'
                    ]
                    // /* @endsync */
                    // /* @sync:storeTypes */
                    && request.resource.data.storeType in ['butcher', 'warehouse', 'grocery', 'farm']
                    // /* @endsync */
                    && request.resource.data.source == 'community'
                    && (!('notes' in request.resource.data.keys())
                        || (request.resource.data.notes is string
                            && request.resource.data.notes.size() <= 500));

      // Owner can delete their own submission (e.g. correcting a typo).
      // Update not allowed — resubmit instead, so timestamps stay honest.
      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;

      allow update: if false;
    }

    // ── DEFAULT DENY ─────────────────────────────────────────
  }
}
