<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>BBQ Board</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- Google Sign-In. Both values MUST match ios-board/App/App/GoogleService-Info.plist
	     (project holy-smokes-bbq-board, sender 641836204823). Without GIDClientID the
	     SDK raises at GIDSignIn.m:739 and the app aborts the moment a sign-in starts;
	     a URL scheme from a different project silently breaks the OAuth callback. -->
	<key>GIDClientID</key>
	<string>641836204823-6s0sak603jv42q42d7adtige0u35i3lc.apps.googleusercontent.com</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>GoogleSignIn</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.641836204823-6s0sak603jv42q42d7adtige0u35i3lc</string>
			</array>
		</dict>
	</array>
	<!-- These strings are shown verbatim in the iOS permission prompt and are read by
	     App Review. They must describe features BBQ Board actually has: shop search by
	     distance, and scanning a weekly ad to pull prices out of it. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>BBQ Board uses your location to sort butcher shops and meat counters by how far they are from you. Your location is never stored or shared.</string>
	<key>NSCameraUsageDescription</key>
	<string>BBQ Board uses the camera so you can photograph a store's weekly ad and have the per-pound prices read off it for you.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>BBQ Board accesses your photo library so you can pick an existing photo of a weekly ad to scan for prices.</string>
</dict>
</plist>
